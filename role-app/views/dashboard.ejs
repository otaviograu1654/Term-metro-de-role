<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Area do Criador | Como Ta o Role?</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="app-shell">
    <section class="role-header">
      <form action="/logout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="text-button">Sair</button>
      </form>
      <p class="eyebrow">Area do criador</p>
      <h1>Como Tá o Rolê?</h1>
    </section>

    <section class="card">
      <form action="/roles" method="POST" class="stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="nome">Nome do rolê</label>
        <input id="nome" name="nome" type="text" maxlength="100" required placeholder="Ex: Sexta na casa da Ana">
        <label for="tipo_role">Tipo do role</label>
        <select id="tipo_role" name="tipo_role">
          <option value="">Escolher depois</option>
          <option value="Aniversario">Aniversario</option>
          <option value="Pub/bar">Pub/bar</option>
          <option value="Esquenta">Esquenta</option>
          <option value="After">After</option>
          <option value="Casa de amigo">Casa de amigo</option>
          <option value="Festa fechada">Festa fechada</option>
        </select>
        <label for="descricao">Descricao do role</label>
        <textarea id="descricao" name="descricao" maxlength="280" rows="3" placeholder="Ex: Aniversario do Joao, pode levar 1 amigo."></textarea>
        <label for="regras">Regras ou observacoes</label>
        <textarea id="regras" name="regras" maxlength="700" rows="4" placeholder="Ex: Nao divulgar o link, chegar depois das 21h."></textarea>
        <label for="aviso_fixado">Aviso fixado</label>
        <input id="aviso_fixado" name="aviso_fixado" type="text" maxlength="180" placeholder="Ex: Quem chegar chama no WhatsApp.">
        <label for="local_nome">Local</label>
        <input id="local_nome" name="local_nome" type="text" maxlength="120" placeholder="Ex: Pub Central, casa do Joao">
        <label for="endereco">Endereco</label>
        <input id="endereco" name="endereco" type="text" maxlength="180" placeholder="Ex: Rua A, 123">
        <label for="maps_url">Link do Google Maps</label>
        <input id="maps_url" name="maps_url" type="url" maxlength="500" placeholder="https://maps.google.com/...">
        <button type="submit" class="primary-button">Criar rolê</button>
      </form>
    </section>

    <section class="card">
      <div class="section-title">
        <div>
          <p class="eyebrow">Seus links</p>
          <h2>Rolês criados</h2>
        </div>
      </div>
      <% if (roles.length === 0) { %>
        <p class="empty">Nenhum rolê criado ainda.</p>
      <% } else { %>
        <ul class="creator-list">
          <% roles.forEach(function(role) { %>
            <li>
              <div>
                <strong><%= role.nome %></strong>
                <span><%= role.codigo %> · <%= role.participantes %> participantes · <%= role.avaliacoes %> avaliações</span>
                <% if (role.local_nome || role.endereco) { %>
                  <span><%= role.local_nome || role.endereco %></span>
                <% } %>
                <% if (role.tipo_role) { %>
                  <span><%= role.tipo_role %></span>
                <% } %>
                <span><%= role.expirado ? 'Encerrado' : 'Encerra em ' + role.expiracao_label %></span>
              </div>
              <div class="creator-actions">
                <a class="small-link" href="/role/<%= role.codigo %>">Abrir</a>
                <a class="small-link" href="/dashboard/role/<%= role.codigo %>">Moderar</a>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </main>
</body>
</html>
