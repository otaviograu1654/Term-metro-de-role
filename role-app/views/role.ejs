<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= role.nome %> | Como Ta o Role?</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="app-shell">
    <section class="role-header">
      <% if (creatorLoggedIn) { %>
        <a class="back-link" href="/dashboard">Painel</a>
      <% } %>
      <p class="eyebrow">Role privado</p>
      <h1><%= role.nome %></h1>
      <span class="code-pill"><%= role.codigo %></span>
    </section>

    <section class="card share-card">
      <p>Compartilhe este link com seus amigos:</p>
      <div class="copy-row">
        <input id="shareLink" type="text" value="<%= shareUrl %>" readonly>
        <button type="button" id="copyLinkButton" class="small-button">Copiar link</button>
      </div>
      <a class="whatsapp-button" href="<%= whatsappShareUrl %>" target="_blank" rel="noopener">Mandar no WhatsApp</a>
      <p class="expires-text">Encerra em <%= expiration.expiresAtLabel %></p>
      <p id="copyFeedback" class="feedback" aria-live="polite"></p>
    </section>

    <% if (typeof aviso !== 'undefined' && aviso) { %>
      <section class="toast-card" role="status">
        <p><%= aviso %></p>
      </section>
    <% } %>

    <% if (expiration.isExpired) { %>
      <section class="card expired-card">
        <p class="eyebrow">Role encerrado</p>
        <p>Este link ficou aberto por 24 horas e agora nao aceita novas entradas ou votos.</p>
      </section>
    <% } %>

    <% if (!participante && !expiration.isExpired) { %>
      <section class="card">
        <form action="/role/<%= role.codigo %>/entrar" method="POST" class="stack">
          <label for="nome">Seu nome ou apelido</label>
          <input id="nome" name="nome" type="text" maxlength="60" required placeholder="Ex: Otavio">
          <div class="avatar-picker">
            <p class="eyebrow">Escolha seu avatar</p>
            <div class="avatar-grid">
              <% avatarOptions.forEach(function(avatar, index) { %>
                <label class="avatar-option">
                  <input type="radio" name="avatar" value="<%= avatar.id %>" <%= index === 0 ? 'checked' : '' %>>
                  <% if (avatar.image) { %>
                    <img class="avatar-img" src="<%= avatar.image %>" alt="Avatar <%= index + 1 %>">
                  <% } else { %>
                    <span class="avatar-icon"><%= avatar.icon %></span>
                  <% } %>
                </label>
              <% }) %>
            </div>
          </div>
          <button type="submit" class="primary-button">Entrar no rolê</button>
        </form>
      </section>
    <% } else if (participante) { %>
      <% const avatarParticipante = avatarOptions.find(function(a) { return a.id === participante.participante_avatar; }); %>
      <section class="profile-card">
        <% if (avatarParticipante && avatarParticipante.image) { %>
          <img class="avatar-profile" src="<%= avatarParticipante.image %>" alt="">
        <% } else if (avatarParticipante && avatarParticipante.icon) { %>
          <span class="avatar-profile avatar-profile-fallback"><%= avatarParticipante.icon %></span>
        <% } %>
        <div>
          <span>VocÃª estÃ¡ no rolÃª como</span>
          <strong><%= participante.participante_nome %></strong>
        </div>
      </section>

      <section class="thermo-card">
        <div class="thermo-top">
          <div>
            <p class="eyebrow">Clima geral</p>
            <strong><%= termometro.media %>%</strong>
          </div>
          <span><%= termometro.quantidade %> pessoa<%= termometro.quantidade === 1 ? '' : 's' %> votaram</span>
        </div>
        <div class="meter" aria-label="Clima geral em <%= termometro.media %>%">
          <span style="width: <%= termometro.media %>%"></span>
        </div>
        <p class="most-voted">Sinal mais comum: <strong><%= termometro.sinalMaisVotado %></strong></p>
      </section>

      <section class="card">
        <div class="section-title">
          <div>
            <p class="eyebrow">No rolê</p>
            <h2>Quem entrou</h2>
          </div>
          <span class="count-pill"><%= participantes.length %></span>
        </div>
        <% if (participantes.length === 0) { %>
          <p class="empty">Ainda ninguem entrou.</p>
        <% } else { %>
          <ul class="participant-list">
            <% participantes.forEach(function(pessoa) { %>
              <% const avatarPessoa = avatarOptions.find(function(a) { return a.id === pessoa.avatar; }); %>
              <li class="<%= pessoa.id === participante.participante_id ? 'is-current' : '' %>">
                <% if (avatarPessoa && avatarPessoa.image) { %>
                  <img class="avatar-tiny" src="<%= avatarPessoa.image %>" alt="">
                <% } else if (avatarPessoa && avatarPessoa.icon) { %>
                  <span><%= avatarPessoa.icon %></span>
                <% } %>
                <div>
                  <strong><%= pessoa.nome %><%= pessoa.id === participante.participante_id ? ' · você' : '' %></strong>
                  <span><%= pessoa.ultima_interacao_label %></span>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <% if (!expiration.isExpired) { %>
      <section class="card">
        <div class="section-title">
          <div>
            <p class="eyebrow">Avaliar como</p>
            <h2>Sua avaliação</h2>
          </div>
        </div>
        <% const avatarParticipante = avatarOptions.find(function(a) { return a.id === participante.participante_avatar; }); %>
        <div class="profile-strip is-hidden">
          <% if (avatarParticipante && avatarParticipante.image) { %>
            <img class="avatar-profile" src="<%= avatarParticipante.image %>" alt="">
          <% } else if (avatarParticipante && avatarParticipante.icon) { %>
            <span class="avatar-profile avatar-profile-fallback"><%= avatarParticipante.icon %></span>
          <% } %>
          <div>
            <span>Você está como</span>
            <strong><%= participante.participante_nome %></strong>
          </div>
        </div>

        <form action="/role/<%= role.codigo %>/votar" method="POST" id="voteForm">
          <div class="score-box">
            <label for="nota">Nota do rolê</label>
            <div class="score-value">
              <strong id="scoreOutput">75</strong>
              <span>/100</span>
            </div>
            <input id="nota" name="nota" type="range" min="0" max="100" value="75" step="1">
            <div class="score-scale">
              <span>0</span>
              <span>50</span>
              <span>100</span>
            </div>
          </div>

          <label class="check-row">
            <input type="checkbox" id="anonymousCheckbox">
            <span>Enviar anonimamente</span>
          </label>
          <input type="hidden" name="anonimo" id="anonymousInput" value="false">

          <input type="hidden" name="status" id="statusInput" value="">
          <div class="signal-title">
            <p class="eyebrow">Sinal do rolê</p>
            <span>Opcional, não mexe na nota</span>
          </div>
          <div class="signal-tabs" role="tablist" aria-label="Categorias de sinal">
            <% statusCategories.forEach(function(category, index) { %>
              <button
                class="signal-tab <%= index === 0 ? 'is-active' : '' %>"
                type="button"
                data-signal-tab="<%= category.id %>">
                <%= category.label %>
              </button>
            <% }) %>
          </div>
          <div class="signal-panels">
            <% statusCategories.forEach(function(category, index) { %>
              <div class="signal-panel <%= index === 0 ? 'is-active' : '' %>" data-signal-panel="<%= category.id %>">
                <div class="vote-grid signal-grid">
                  <% category.statuses.forEach(function(status) { %>
                    <button
                      class="vote-button"
                      type="button"
                      data-status="<%= status %>"
                      data-commentable="<%= commentableStatuses.includes(status) ? 'true' : 'false' %>"
                      data-sensitive="<%= sensitiveStatuses.includes(status) ? 'true' : 'false' %>">
                      <%= status %>
                    </button>
                  <% }) %>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="comment-box is-hidden" id="commentBox">
            <label for="comentario">Comentário curto</label>
            <input id="comentario" name="comentario" type="text" maxlength="30" placeholder="Até 30 caracteres">
          </div>
          <button type="submit" class="primary-button submit-vote">Enviar avaliação</button>
        </form>
      </section>
      <% } %>

      <section class="card">
        <div class="section-title">
          <div>
            <p class="eyebrow">Ao vivo</p>
            <h2>Últimas avaliações</h2>
          </div>
        </div>
        <% if (recentes.length === 0) { %>
          <p class="empty">Ainda ninguem votou nesse role.</p>
        <% } else { %>
          <ul class="recent-list">
            <% recentes.forEach(function(voto) { %>
              <li>
                <% const avatarAtual = avatarOptions.find(function(a) { return a.id === voto.participante_avatar; }); %>
                <span class="activity-person">
                  <% if (voto.anonimo) { %>
                    Anônimo
                  <% } else { %>
                    <% if (avatarAtual && avatarAtual.image) { %>
                      <img class="avatar-tiny" src="<%= avatarAtual.image %>" alt="">
                    <% } else if (avatarAtual && avatarAtual.icon) { %>
                      <span><%= avatarAtual.icon %></span>
                    <% } %>
                    <%= voto.participante_nome %>
                  <% } %>
                  · <%= voto.horario %>
                </span>
                <strong><%= voto.nota %>/100<%= voto.status ? ' · ' + voto.status : '' %></strong>
                <% if (voto.comentario) { %>
                  <p class="short-comment"><%= voto.comentario %></p>
                <% } %>
                <% if (voto.quickPollOptions) { %>
                  <div class="quick-poll">
                    <% voto.quickPollOptions.forEach(function(opcao) { %>
                      <form action="/role/<%= role.codigo %>/sinal/<%= voto.id %>/responder" method="POST">
                        <input type="hidden" name="resposta" value="<%= opcao %>">
                        <% if (voto.status === '🗺️ Vamo pra outro lugar' && opcao === 'Bora') { %>
                          <input
                            class="suggestion-input"
                            name="sugestao"
                            type="text"
                            maxlength="40"
                            placeholder="Sugere um lugar"
                            value="<%= voto.quickPollUserResponse === opcao && voto.quickPollUserSuggestion ? voto.quickPollUserSuggestion : '' %>"
                            <%= expiration.isExpired || voto.participante_id === participante.participante_id ? 'disabled' : '' %>>
                        <% } %>
                        <button
                          type="submit"
                          class="poll-button <%= voto.quickPollUserResponse === opcao ? 'is-selected' : '' %>"
                          <%= expiration.isExpired || voto.participante_id === participante.participante_id || voto.quickPollUserResponse ? 'disabled' : '' %>>
                          <span><%= opcao %></span>
                          <strong><%= voto.quickPollCounts[opcao] || 0 %></strong>
                        </button>
                      </form>
                    <% }) %>
                    <% if (voto.quickPollSuggestions && voto.quickPollSuggestions.length > 0) { %>
                      <div class="suggestions">
                        <span>Sugestões:</span>
                        <% voto.quickPollSuggestions.forEach(function(sugestao) { %>
                          <div class="suggestion-card">
                            <strong><%= sugestao.texto %></strong>
                            <div class="suggestion-actions">
                              <form action="/role/<%= role.codigo %>/sugestao/<%= sugestao.id %>/votar" method="POST">
                                <input type="hidden" name="valor" value="1">
                                <button
                                  type="submit"
                                  class="mini-vote <%= sugestao.userVote === 1 ? 'is-selected' : '' %>"
                                  <%= expiration.isExpired || sugestao.participante_id === participante.participante_id || sugestao.userVote ? 'disabled' : '' %>>
                                  👍 <%= sugestao.positivos %>
                                </button>
                              </form>
                              <form action="/role/<%= role.codigo %>/sugestao/<%= sugestao.id %>/votar" method="POST">
                                <input type="hidden" name="valor" value="-1">
                                <button
                                  type="submit"
                                  class="mini-vote <%= sugestao.userVote === -1 ? 'is-selected' : '' %>"
                                  <%= expiration.isExpired || sugestao.participante_id === participante.participante_id || sugestao.userVote ? 'disabled' : '' %>>
                                  👎 <%= sugestao.negativos %>
                                </button>
                              </form>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>
    <% } %>
  </main>
  <div class="avatar-preview" id="avatarPreview" aria-hidden="true">
    <button type="button" class="avatar-preview-close" id="avatarPreviewClose" aria-label="Fechar preview">×</button>
    <img id="avatarPreviewImage" src="" alt="">
  </div>
  <script src="/app.js"></script>
</body>
</html>
